<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_session_handover_list" model="ir.ui.view">
        <field name="name">pos.session.handover.list</field>
        <field name="model">pos.session.handover</field>
        <field name="arch" type="xml">
            <list string="Bàn giao ca POS">
                <field name="session_id" string="Phiên POS"/>
                <field name="currency_id" column_invisible="True"/>

                <field name="expected_amount"
                       string="Tiền dự kiến"
                       widget="monetary"
                       options="{'currency_field': 'currency_id'}"/>

                <field name="counted_amount"
                       string="Tiền thực đếm"
                       widget="monetary"
                       options="{'currency_field': 'currency_id'}"/>

                <field name="difference_amount"
                       string="Chênh lệch"
                       widget="monetary"
                       options="{'currency_field': 'currency_id'}"/>

                <field name="state"
                       string="Trạng thái"
                       widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_pos_session_handover_form" model="ir.ui.view">
        <field name="name">pos.session.handover.form</field>
        <field name="model">pos.session.handover</field>
        <field name="arch" type="xml">
            <form string="Bàn giao ca POS">
                <header>
                    <button name="action_submit"
                            string="Gửi"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <button name="action_confirm"
                            string="Xác nhận"
                            type="object"
                            class="btn-primary"
                            groups="point_of_sale.group_pos_manager"
                            invisible="state != 'submitted'"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,submitted,confirmed"
                           readonly="True"/>
                </header>

                <sheet>
                    <group>
                        <field name="session_id"
                               string="Phiên POS"
                               options="{'no_create': True}"
                               readonly="state != 'draft'"/>

                        <field name="currency_id" invisible="True"/>

                        <field name="expected_amount"
                               string="Tiền dự kiến"
                               widget="monetary"
                               options="{'currency_field': 'currency_id'}"
                               readonly="True"/>

                        <field name="counted_amount"
                               string="Tiền thực đếm"
                               widget="monetary"
                               options="{'currency_field': 'currency_id'}"
                               readonly="state != 'draft'"/>

                        <field name="difference_amount"
                               string="Chênh lệch"
                               widget="monetary"
                               options="{'currency_field': 'currency_id'}"
                               readonly="True"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_pos_session_handover_search" model="ir.ui.view">
        <field name="name">pos.session.handover.search</field>
        <field name="model">pos.session.handover</field>
        <field name="arch" type="xml">
            <search string="Tìm phiếu bàn giao ca">
                <field name="session_id" string="Phiên POS"/>

                <filter name="draft"
                        string="Nháp"
                        domain="[('state', '=', 'draft')]"/>

                <filter name="submitted"
                        string="Đã gửi"
                        domain="[('state', '=', 'submitted')]"/>

                <filter name="confirmed"
                        string="Đã xác nhận"
                        domain="[('state', '=', 'confirmed')]"/>

                <group expand="0" string="Nhóm theo">
                    <filter name="group_by_state"
                            string="Trạng thái"
                            context="{'group_by': 'state'}"/>

                    <filter name="group_by_session"
                            string="Phiên POS"
                            context="{'group_by': 'session_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pos_session_handover" model="ir.actions.act_window">
        <field name="name">Bàn giao ca POS</field>
        <field name="res_model">pos.session.handover</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_pos_session_handover_list"/>
        <field name="search_view_id"
               ref="view_pos_session_handover_search"/>
    </record>

    <menuitem id="menu_pos_session_handover"
              name="Bàn giao ca"
              parent="point_of_sale.menu_point_root"
              action="action_pos_session_handover"
              groups="point_of_sale.group_pos_user"
              sequence="50"/>
</odoo>